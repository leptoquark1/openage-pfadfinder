{
  "name": "@leptoquark1/openage-pfadfinder",
  "version": "1.0.0",
  "description": "TypeScript port of the Pathfinding Subsystem",
  "keywords": [
    "a-star",
    "age-of-empires",
    "esm",
    "grid",
    "openage",
    "pathfinding",
    "typescript"
  ],
  "homepage": "https://github.com/leptoquark1/openage-pfadfinder#readme",
  "bugs": {
    "url": "https://github.com/leptoquark1/openage-pfadfinder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leptoquark1/openage-pfadfinder.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "David Fecke (leptoquark1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:package",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "changeset-conventional-commits": "^1.0.4",
    "eslint": "10.14.0",
    "publint": "0.3.25",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
