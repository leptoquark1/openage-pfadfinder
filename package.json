{
  "name": "openage-pfadfinder-workspace",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "David Fecke (leptoquark1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "benchmark": "pnpm --reporter=silent --filter @leptoquark1/openage-pfadfinder benchmark",
    "benchmark:crowd": "pnpm --reporter=silent --filter @leptoquark1/openage-pfadfinder-crowd benchmark",
    "test:coverage": "pnpm -r --filter './packages/*' test:coverage && pnpm --filter @leptoquark1/openage-pfadfinder-demo test",
    "test:perf": "pnpm --filter @leptoquark1/openage-pfadfinder-demo test:perf",
    "check:package": "pnpm -r --filter './packages/*' check:package",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm check:package",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "changeset-conventional-commits": "^1.0.4",
    "typescript": "7.0.2"
  }
}
