{
  "name": "openage-pfadfinder-workspace",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "David Fecke (leptoquark1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "pnpm --filter @leptoquark1/openage-pfadfinder build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "benchmark": "pnpm --reporter=silent --filter @leptoquark1/openage-pfadfinder benchmark",
    "test:coverage": "pnpm --filter @leptoquark1/openage-pfadfinder test:coverage && pnpm --filter @leptoquark1/openage-pfadfinder-demo test",
    "test:perf": "pnpm --filter @leptoquark1/openage-pfadfinder-demo test:perf",
    "check:package": "pnpm --filter @leptoquark1/openage-pfadfinder check:package",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm check:package",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "changeset-conventional-commits": "^1.0.4",
    "eslint": "10.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  }
}
