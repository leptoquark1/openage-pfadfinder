{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@leptoquark1/openage-pfadfinder": ["../../packages/pfadfinder/dist/index.d.ts"],
      "@leptoquark1/openage-pfadfinder/shared": ["../../packages/pfadfinder/dist/shared/index.d.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "vitest.perf.config.ts"]
}
